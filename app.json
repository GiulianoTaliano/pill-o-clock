{
  "expo": {
    "name": "Pill O-Clock",
    "slug": "pill-o-clock",
    "version": "1.8.0",
    "scheme": "pilloclock",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0f6ff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pilloclock.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIUserInterfaceStyle": "Automatic",
        "UIBackgroundModes": [
          "fetch"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "locales": {
      "es": "./locales/es.json",
      "pt": "./locales/pt.json",
      "en": "./locales/en.json"
    },
    "android": {
      "package": "com.pilloclock.app",
      "versionCode": 37,
      "adaptiveIcon": {
        "backgroundColor": "#f0f6ff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pill O-Clock uses your location to pin the exact place of your medical appointments on the map.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pill O-Clock uses the camera to scan the barcode on a medication package and fill in the medication details.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pill O-Clock uses your photos so you can attach a picture of the package to each medication.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pill O-Clock uses Face ID to unlock the app when app lock is enabled."
        }
      ],
      "expo-secure-store",
      "react-native-health-connect",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6639820412660854~4363189908",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      "./modules/expo-alarm/app.plugin.js",
      "./modules/expo-widget/app.plugin.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4f9cff",
          "sounds": [
            "./assets/alarm.wav"
          ],
          "androidMode": "default",
          "androidCollapsedTitle": "Recordatorio de medicamento"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "pill-o-clock",
          "project": "pill-o-clock"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b839d42f-5883-4785-b1a3-8c31465875c0"
      }
    },
    "owner": "giulianotaliano"
  }
}
